# Supabase — คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# (ดู key ได้ที่ Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# service_role key — ใช้เฉพาะฝั่งเซิร์ฟเวอร์ (lib/supabase/admin.ts) สำหรับสร้าง/รีเซ็ต
# รหัสผ่านผู้ใช้ผ่าน Supabase Admin API เท่านั้น ห้ามใส่ NEXT_PUBLIC_ นำหน้าเด็ดขาด —
# key นี้ bypass RLS ทั้งหมด ต้องตั้งใน Vercel ด้วย (Settings → Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx
